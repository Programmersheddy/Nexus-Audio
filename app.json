{
  "expo": {
    "name": "THE-AUDIO",
    "slug": "THE-AUDIO",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.programmersheddy.theaudio",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Nexus Audio needs microphone access to listen for voice commands.",
        "NSSpeechRecognitionUsageDescription": "Nexus Audio needs speech recognition to process voice commands.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ],
      "package": "com.programmersheddy.THEAUDIO"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "@dev-amirzubair/react-native-voice",
        {
          "microphonePermission": "CUSTOM: Allow $(PRODUCT_NAME) to access the microphone",
          "speechRecognitionPermission": "CUSTOM: Allow $(PRODUCT_NAME) to securely recognize user speech"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow THE-AUDIO to access the camera for smart vision analysis.",
          "microphonePermission": "Allow THE-AUDIO to access the microphone."
        }
      ],
      [
        "react-native-permissions",
        {
          "iosPermissions": [
            "Microphone",
            "SpeechRecognition"
          ],
          "androidPermissions": [
            "RECORD_AUDIO"
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "8229fd85-3dff-4bbd-8975-ad8891cc345b"
      }
    }
  }
}